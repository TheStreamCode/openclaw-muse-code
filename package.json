{
  "name": "@thestreamcode/openclaw-muse-code",
  "version": "0.1.1",
  "description": "Muse Spark in OpenClaw billed to the Muse Code monthly subscription (Meta device login, no API key)",
  "type": "module",
  "license": "MIT",
  "private": false,
  "author": "TheStreamCode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheStreamCode/openclaw-muse-code.git"
  },
  "homepage": "https://github.com/TheStreamCode/openclaw-muse-code#readme",
  "bugs": {
    "url": "https://github.com/TheStreamCode/openclaw-muse-code/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/TheStreamCode"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist",
    "prepack": "npm run build",
    "login": "node scripts/muse-code-login.mjs"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "muse-code",
    "muse-spark",
    "meta-ai",
    "llm",
    "provider"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "providers": [
      "muse-code"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1",
      "minGatewayVersion": "2026.7.1"
    },
    "build": {
      "openclawVersion": "2026.9.5",
      "pluginSdkVersion": "2026.9.5"
    }
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1"
  },
  "devDependencies": {
    "openclaw": "2026.9.5",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
